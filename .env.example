# OpenAI — powers the AERO router's live explanations/reasoning.
# Set this in Vercel → Project → Settings → Environment Variables (do NOT commit a real key).
OPENAI_API_KEY=

# Optional: override the model (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: where to forward Request-Access leads (Zapier/Make/CRM webhook).
# Without it, leads are accepted and logged so the form still works.
WAITLIST_WEBHOOK_URL=
