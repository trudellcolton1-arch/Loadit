# OpenAI — powers the AERO router's live explanations/reasoning.
# Set this in Vercel → Project → Settings → Environment Variables (do NOT commit a real key).
OPENAI_API_KEY=

# Optional: override the model (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# HQ — your AI (the in-app assistant at /api/hq). Live key for the HQ service.
# Set in Vercel → Project → Settings → Environment Variables (do NOT commit a real key).
HQ_LOADIT_KEY=

# Optional: where to forward Request-Access leads (Zapier/Make/CRM webhook).
# Without it, leads are accepted and logged so the form still works.
WAITLIST_WEBHOOK_URL=

# --- Temporal Exchange funding (optional; deposits stay in demo mode without these) ---
# Stripe (cards / onramp): https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Coinbase Commerce (crypto deposits): https://commerce.coinbase.com/
COINBASE_COMMERCE_API_KEY=
# Self-custody deposit address (shown to users for on-chain transfers)
DEPOSIT_WALLET_ADDRESS=

# --- AERO API (public routing API at /api/v1/route) ---
# Static production keys (comma-separated). 'demo' always works, rate-limited.
AERO_API_KEYS=
# Secret used to sign/verify stateless API keys issued on Stripe subscription.
# Generate: openssl rand -hex 32
AERO_SIGNING_SECRET=
# Comma-separated key ids (kid) to revoke (e.g. after a cancellation).
API_KEYS_REVOKED=

# --- AERO API billing (Stripe subscription) ---
# Recurring Price id for the Startup plan: https://dashboard.stripe.com/prices
STRIPE_PRICE_STARTUP=
# Webhook signing secret for /api/stripe/webhook: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=
# Where to deliver an issued API key (email/CRM automation). Falls back to
# WAITLIST_WEBHOOK_URL, then server logs.
KEY_DELIVERY_WEBHOOK_URL=

# --- Request Access leads -> your inbox ---
# Free key from https://resend.com (100 emails/day on the free tier). With it
# set, every Request Access submission is emailed to LEADS_TO.
RESEND_API_KEY=
# LEADS_TO=colt@loadit.net
# LEADS_FROM=Loadit <onboarding@resend.dev>

# --- Funnel analytics (affiliate clicks, route computes) ---
# Where /api/track forwards events (Zapier/PostHog/sheet/DB). Logs if unset.
ANALYTICS_WEBHOOK_URL=

# --- HQ Quantum Routing · Phase 1 (post-quantum receipts; lib/quantum.ts) ---
# 32-byte hex seed for Loadit's ML-DSA-65 signing identity (FIPS 204).
# Generate: openssl rand -hex 32. Receipts verify at /verify/<id>.
LOADIT_MLDSA_SEED=
# Optional: HQ quantum-entropy endpoint (returns {"hex":"..."}). Until set,
# nonces use the OS CSPRNG and receipts say so honestly.
# HQ_ENTROPY_URL=
# Optional: set by the Phase-2 QAOA job; until then receipts report
# "classical-v1 (QAOA batch pending)".
# QUANTUM_BATCH_ID=

# --- HQ Content Engine (SEO pages at /p/<slug>; lib/hqContent.ts) ---
# Read-only connection to HQ's Neon where hq_content_page lives (a SEPARATE
# database from HYLAQ_DATABASE_URL). Falls back to HYLAQ_DATABASE_URL if unset.
HQ_CONTENT_DATABASE_URL=

# --- HQ Fraud Shield (real-time on-ramp abuse gate; lib/risk.ts + guardOnramp) ---
# Deterministic risk scoring on every on-ramp attempt before the provider
# hand-off (abuse gate, NOT KYC/AML). Fails open — a scoring bug never breaks
# payments. Velocity is keyed by a SHA-256 IP hash; the raw IP is never stored.
# Non-allow verdicts are logged fire-and-forget to ANALYTICS_WEBHOOK_URL.
#
# Rollout: ship in SHADOW first (score + log, block nothing), watch the webhook,
# then REMOVE the shadow var to arm blocking.
#   LOADIT_RISK_BLOCK=0   -> shadow mode (score + log only). Remove to arm.
LOADIT_RISK_BLOCK=0
#   LOADIT_FRAUD_BYPASS=1 -> total pass-through / kill switch.
# LOADIT_FRAUD_BYPASS=
#   HQ_RISK_URL -> optional HQ advisory endpoint. It can only RAISE suspicion
#   (allow -> review); it can never block on its own.
# HQ_RISK_URL=

# --- Mobile app: non-custodial on-ramps (cash/card -> user's own wallet) ---
# Coinbase Onramp app id (Coinbase Developer Platform → Onramp).
COINBASE_ONRAMP_APP_ID=
# Stripe Crypto Onramp uses STRIPE_SECRET_KEY (already set above).
# Hylaq SSO (login with hylaq.com) — fill from Hylaq's OAuth/OIDC app.
HYLAQ_ISSUER=
HYLAQ_CLIENT_ID=
HYLAQ_CLIENT_SECRET=
