{
  "expo": {
    "name": "Loadit",
    "slug": "loadit",
    "scheme": "loadit",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "net.loadit.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Loadit uses the microphone so you can speak your money requests to HQ.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.loadit.app",
      "permissions": ["RECORD_AUDIO", "INTERNET"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#04060B"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiBase": "https://loadit.net",
      "aeroApiKey": "demo",
      "hylaq": {
        "issuer": "https://www.hylaq.com",
        "clientId": "hyq_client_dc0eb8d82bb0af1a2d4961ac",
        "scopes": ["read"]
      },
      "router": { "origin": false }
    }
  }
}
