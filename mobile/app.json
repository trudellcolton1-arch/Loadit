{
  "expo": {
    "name": "Loadit",
    "slug": "loadit",
    "scheme": "loadit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#04060B",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#04060B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "net.loadit.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Loadit uses the microphone so you can speak your money requests to AERO."
      }
    },
    "android": {
      "package": "net.loadit.app",
      "permissions": ["RECORD_AUDIO", "INTERNET"]
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "apiBase": "https://loadit.net",
      "aeroApiKey": "demo",
      "hylaq": {
        "issuer": "",
        "clientId": "",
        "scopes": ["openid", "profile", "email"]
      },
      "router": { "origin": false }
    }
  }
}
